<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Localimed.Views.RemoverMedicamentos"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#D8D8D8">

    <Grid RowDefinitions="90,*">
        <Border Grid.Row="0" BackgroundColor="#001240" StrokeThickness="0">
            <Grid Padding="25,0">
                <Label Text="LOCALIMED" TextColor="White" FontSize="36"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Frame WidthRequest="65" HeightRequest="65" CornerRadius="33"
                       BackgroundColor="White" Padding="5" HasShadow="False"
                       HorizontalOptions="End" VerticalOptions="Center">
                    <Image Source="logopng.png" Aspect="AspectFit" />
                </Frame>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border WidthRequest="1100" HeightRequest="680"
                    BackgroundColor="White" StrokeThickness="0"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
            </Border>

            <VerticalStackLayout WidthRequest="900"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">

                <Border WidthRequest="550" HeightRequest="50"
                        BackgroundColor="#D9D9D9" Stroke="#A0A0A0"
                        HorizontalOptions="Center">
                    <Label Text="Remover Medicamentos"
                           FontSize="27" FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <Grid BackgroundColor="#001240"
                      ColumnDefinitions="3*,1*,1.3*"
                      HeightRequest="55" Padding="8">
                    <Label Text="Medicamento" TextColor="White"
                           FontSize="22" FontAttributes="Bold"
                           VerticalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Quantidade" TextColor="White"
                           FontSize="22" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="Dosagem" TextColor="White"
                           FontSize="22" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>

                <CollectionView
                    x:Name="MedicamentosCollectionView"
                    ItemsSource="{Binding Medicamentos}"
                    SelectionMode="Single"
                    SelectedItem="{Binding MedicamentoSelecionado, Mode=TwoWay}"
                    HeightRequest="410">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="3*,1*,1.3*"
                                  HeightRequest="48"
                                  Padding="8"
                                  BackgroundColor="#E9EEF5">
                                <Label Text="{Binding NomeMedicamento}"
                                       TextColor="Black" FontSize="14" 
                                       FontAttributes="Bold" 
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Quantidade}"
                                       TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Dosagem}"
                                       TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding MensagemSelecao}"
                       TextColor="Red"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       LineBreakMode="TailTruncation"
                       WidthRequest="850" />

                <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                    <Button Text="VOLTAR" Command="{Binding BotaoVoltar}"
                            WidthRequest="150" HeightRequest="48"
                            CornerRadius="24" BackgroundColor="#808080"
                            TextColor="White" />
                    <Button Text="REMOVER" Command="{Binding BotaoRemoverMedicamento}"
                            IsEnabled="{Binding PodeRemover}"
                            WidthRequest="170" HeightRequest="48"
                            CornerRadius="24" BackgroundColor="#808080"
                            TextColor="White" />
                    <Button Text="ADICIONAR" Command="{Binding BotaoInserirMedicamentos}"
                            WidthRequest="170" HeightRequest="48"
                            CornerRadius="24" BackgroundColor="#001240"
                            TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
